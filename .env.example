# OpenDots self-hosted configuration. Copy to .env and edit.
# The UI opens in setup state until a model provider is configured.

# --- Server --------------------------------------------------------------
HOST=127.0.0.1
PORT=4310
DATABASE_PATH=data/opendots.sqlite
# Keep OWNER_ID stable: it owns the local conversations and Learning state.
OWNER_ID=opendots-owner
# npm run dev allows http://localhost:5173 and http://127.0.0.1:5173.
# APP_ORIGIN replaces these defaults with comma-separated exact origins.
# Include scheme, hostname and port; omit paths and trailing slashes.
# APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Required for an external HOST binding (24+ characters); also the browser login.
# OWNER_TOKEN=

# --- Model provider (required for conversations) -------------------------
# openai-compatible (DeepSeek, vLLM, LM Studio, OpenRouter, ...) or ollama.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=
# Maximum completion tokens per model call (default 2200).
# AI_MAX_OUTPUT_TOKENS=2200
# Maximum duration for Dot turns and scheduled/background runs (milliseconds).
# AGENT_RUN_TIMEOUT_MS=90000
# Maximum serialized size of one persisted AG-UI event (default 512 KiB).
# AGENT_MAX_EVENT_BYTES=524288

# Ollama example (no real key is required; "ollama" is a placeholder).
# AI_PROVIDER=ollama
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=llama3.1

# Existing deployments may keep using these names instead of AI_*.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=

# --- Automatic Learning (local) ------------------------------------------
# Evidence rows retained per Learning container (default 2000). Conversations
# themselves are never trimmed. See docs/LEARNING.md.
# LEARNING_EVIDENCE_LIMIT=2000

# --- Slack (optional, direct integration) --------------------------------
# Socket Mode app: no public HTTPS endpoint and no CopilotKit Intelligence.
# See docs/SLACK.md. Leave all unset to keep Slack disabled.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Channel name (without #) or channel ID that the bot listens to.
SLACK_CHANNEL_NAME=
# Workspace and explicit user allowlist. Comma-separated user IDs.
SLACK_TEAM_ID=
SLACK_USER_IDS=
# SLACK_DOT_ID= (defaults to the initial Dot)

# --- Tools and integrations (all optional) -------------------------------
# Optional isolated read-only public-page browser for WEB_SEARCH_PROVIDER=browser.
BROWSER_URL=http://127.0.0.1:4311
BROWSER_SECRET=
BROWSER_HOST=127.0.0.1
BROWSER_PORT=4311
# Use the same random 24+ character secret in app/browser. All redirects are blocked.
# Supply canonical public URLs. Use the separate browser container for isolation.

# Optional connected apps through Composio; see docs/SETUP.md#composio.
COMPOSIO_API_KEY=

# Optional realtime speech; compute uses the same local conversation.
VOICE_API_KEY=
VOICE_MODEL=
VOICE_NAME=marin

# Optional persistent computers, one per Dot, using OpenBot services.
# See docs/COMPUTERS.md. Keep these two different random secrets on the server.
COMPUTER_SUPERVISOR_URL=
COMPUTER_SUPERVISOR_TOKEN=
COMPUTER_TOKEN=
# Keep stable: the namespace identifies existing containers and persistent volumes.
COMPUTER_NAMESPACE=opendots
# COMPUTER_MEMORY_BYTES=2147483648
# COMPUTER_RUNTIME=runsc
# ENGINE_SOCKET=/var/run/docker.sock

# Public-web provider. parallel (default), browser (URL-only), or disabled.
# Queries and selected URLs are sent to Parallel; sample mode makes no provider calls.
WEB_SEARCH_PROVIDER=parallel
# Optional Bearer key for production/higher limits; anonymous MCP supports light use.
PARALLEL_API_KEY=

# --- Telemetry -----------------------------------------------------------
# OpenDots sends no telemetry. The local AG-UI runtime is opted out of its own
# usage telemetry automatically (DO_NOT_TRACK=1) unless you explicitly opt in.
# DO_NOT_TRACK=1
# COPILOTKIT_TELEMETRY_DISABLED=true
